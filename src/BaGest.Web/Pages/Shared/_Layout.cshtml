
@using BaGest.Web.Extensions

@inject IOptions<StatisticsOptions> StatisticsOptions
@inject ApplicationVersion Version

<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="description" content="BaGest">
        <meta name="author" content="@Version.Authors">
        @Html.AddReleaseMetaTags()

        <link rel="shortcut icon" href="~/_content/BaGest.Web/favicon.ico">

        <link rel="stylesheet" href="~/_content/BaGest.Web/lib/bootstrap/dist/css/bootstrap.min.css" />
        <link rel="stylesheet" href="~/_content/BaGest.Web/lib/office-ui-fabric-core/dist/css/fabric.min.css" />
        <link rel="stylesheet" href="~/_content/BaGest.Web/css/site.css" />

        <title>@ViewData["Title"] - BaGest</title>
    </head>
    <body>
        <header>
            <nav class="navbar navbar-expand-lg navbar-dark bg-dark" role="navigation">
                <div class="container">
                    <div class="row w-100 align-items-center">
                        <div id="navbar" class="col-sm-12">
                            <ul class="navbar-nav" role="tablist">
                                <li class="nav-item" role="presentation">
                                    <a asp-area="" asp-page="/Index" class="nav-link" role="tab"><span>Packages</span></a>
                                </li>
                                <li class="nav-item" role="presentation">
                                    <a asp-area="" asp-page="/Upload" class="nav-link" role="tab"><span>Upload</span></a>
                                </li>
                                @if (StatisticsOptions.Value.EnableStatisticsPage)
                                {
                                    <li class="nav-item" role="presentation">
                                        <a asp-area="" asp-page="/Statistics" class="nav-link" role="tab"><span>Statistics</span></a>
                                    </li>
                                }
                                <li class="nav-item" role="presentation">
                                    <a class="nav-link" role="tab" href="https://beersolutions.github.io/BaGest/docs" target="_blank" rel="noopener noreferrer">
                                        <span>Documentation</span>
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="container search-container mt-2">
                    <div class="row">
                        <form class="col-sm-12" action="@Url.Page("/Index")" method="get">
                            <div class="input-group">
                                <input type="text"
                                    name="q"
                                    value="@ViewData["SearchQuery"]"
                                    class="form-control"
                                    autoComplete="off"
                                    placeholder="Search packages..." />

                                <button type="submit"
                                        class="btn btn-outline-secondary"
                                        title="Search for packages">
                                    <span class="ms-Icon ms-Icon--Search" aria-hidden="true"></span>
                                </button>
                            </div>

                            @await RenderSectionAsync("SearchForm", required: false)
                        </form>
                    </div>
                </div>
            </nav>
        </header>

        <main role="main" class="container main-container">
            @RenderBody()
        </main>

        <footer class="footer">
            <p>
                Version: @Version.Version
            </p>
            @Html.AddReleaseInformationAsComment()
        </footer>

        <script src="~/_content/BaGest.Web/lib/alpinejs/dist/alpine.js"></script>

        <script src="~/_content/BaGest.Web/lib/jquery/dist/jquery.min.js"></script>
        
        <script src="~/_content/BaGest.Web/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
        <script src="~/_content/BaGest.Web/js/site.js" asp-append-version="true"></script>

        @await RenderSectionAsync("Scripts", required: false)
    </body>
</html>