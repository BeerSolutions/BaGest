<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <PackageTags>NuGet</PackageTags>
    <Description>The libraries to host BaGest on MySQL.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" />
    <!-- Pomelo 9.0.0 pulls MySqlConnector 2.4.0, which is affected by GHSA-473q-m89c-ghf8 (fixed in 2.6.1). -->
    <PackageReference Include="MySqlConnector" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BaGest.Core\BaGest.Core.csproj" />
  </ItemGroup>

</Project>
